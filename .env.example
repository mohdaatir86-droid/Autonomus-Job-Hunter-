# === Core ===
ENABLE_SCHEDULER=true
HUNT_INTERVAL_MINUTES=15
DATABASE_PATH=job_hunter.db
LOG_LEVEL=INFO
CORS_ORIGINS=*
PORTAL_ACCESS_TOKEN=

# === Google Jobs (surfaces Naukri / LinkedIn / Indeed / company sites) ===
SERPAPI_API_KEY=

# === Company ATS boards (comma-separated slugs, not full URLs) ===
GREENHOUSE_BOARDS=
LEVER_SITES=

# === Gmail job-alert ingest (Naukri, LinkedIn, Shine, Monster, Bayt, GulfTalent) ===
# 1. Google Cloud Console → OAuth client (Web)
# 2. Authorized redirect URI = https://autonomous-job-hunter.onrender.com/api/gmail/callback
# 3. Set the three vars below, deploy, open /api/gmail/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://autonomous-job-hunter.onrender.com/api/gmail/callback

# Safety: discovers + scores + prepares drafts only. No automatic form submission.
