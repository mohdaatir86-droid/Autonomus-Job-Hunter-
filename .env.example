# === Core ===
ENABLE_SCHEDULER=true
HUNT_INTERVAL_MINUTES=15
DATABASE_PATH=job_hunter.db
LOG_LEVEL=INFO
CORS_ORIGINS=*
PORTAL_ACCESS_TOKEN=
PORTAL_PUBLIC_URL=https://autonomous-job-hunter.onrender.com

# === Discovery ===
SERPAPI_API_KEY=
GREENHOUSE_BOARDS=
LEVER_SITES=

# === Gmail job alerts ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://autonomous-job-hunter.onrender.com/api/gmail/callback

# === AI (OpenAI-compatible: OpenAI / Groq / OpenRouter / xAI) ===
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# === WhatsApp push (personal) ===
# CallMeBot: https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_PHONE=91XXXXXXXXXX
WHATSAPP_CALLMEBOT_APIKEY=
WHATSAPP_MIN_SCORE=70
