# Job Hunter environment template. Values below are placeholders only.
# Put real values in Render → autonomous-job-hunter-docker → Environment.
# Never commit secrets and never paste API keys into chat.

# === Core ===
# Required for the scheduler. true/false.
ENABLE_SCHEDULER=true
# Optional. Set false when n8n owns the discovery cadence; draft preparation remains scheduled.
# Defaults to ENABLE_SCHEDULER.
ENABLE_INTERNAL_HUNT_SCHEDULER=true
# Optional. Minutes between automatic hunts. Minimum enforced in code is 10. Default 15.
HUNT_INTERVAL_MINUTES=15
# Optional. Used only when DATABASE_URL is unset (local SQLite).
DATABASE_PATH=job_hunter.db
# Required in production. Render PostgreSQL connection string. The app adds sslmode=require if missing.
# Feature: all jobs, hunts, settings, drafts, Gmail tokens.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
LOG_LEVEL=INFO
# Optional. Comma-separated origins. Same-origin dashboard does not need this.
CORS_ORIGINS=*
# Optional but strongly recommended. Locks profile, drafts, automation, and is also the
# fallback OAuth state secret. Generate a long random string in Render. Do not paste it here.
PORTAL_ACCESS_TOKEN=
# Optional. Dedicated 32+ character bearer token for n8n-triggered discovery.
# Keep separate from PORTAL_ACCESS_TOKEN. Store the value in Render and an n8n credential.
N8N_AUTOMATION_TOKEN=
# Optional. Public origin used in notification links.
PORTAL_PUBLIC_URL=https://autonomous-job-hunter-docker.onrender.com

# === Discovery ===
# Optional. Google Jobs via SerpApi. If set but rejected, source status is Unauthorized (HTTP 401).
# Create at https://serpapi.com/manage-api-key and store only in Render as SERPAPI_API_KEY.
# Test: run a hunt, then open /api/sources. Do not print the key.
SERPAPI_API_KEY=
# Optional. Comma-separated public Greenhouse board slugs. If empty, built-in boards are used:
# careem, flexport, instacart.
GREENHOUSE_BOARDS=
# Optional. Comma-separated public Lever site slugs. Missing value is reported as needs setup.
LEVER_SITES=

# === Google sign-in and Gmail job alerts ===
# Google sign-in uses the public OAuth Web client ID and issues a secure portal session.
# The Google account must match the email saved in the private Job Hunter profile.
# Add these exact Authorized redirect URIs to the Web application client:
#   https://autonomous-job-hunter-docker.onrender.com/api/auth/google/session
#   https://autonomous-job-hunter-docker.onrender.com/api/gmail/callback
# Add https://autonomous-job-hunter-docker.onrender.com as an Authorized JavaScript origin.
# Sign-in needs GOOGLE_CLIENT_ID only. Gmail alert reading also needs GOOGLE_CLIENT_SECRET,
# Gmail API enabled, and the gmail.readonly scope. No Gmail password is used.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://autonomous-job-hunter-docker.onrender.com/api/gmail/callback
# Required before /api/gmail/auth will start. Long random string. PORTAL_ACCESS_TOKEN is the fallback.
OAUTH_STATE_SECRET=

# === AI (OpenAI-compatible: OpenAI / Groq / OpenRouter / xAI) ===
# Optional. Draft cover letters and form suggestions. App also accepts OPENAI_API_KEY.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# === WhatsApp push (personal, optional) ===
# CallMeBot: https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_PHONE=
WHATSAPP_CALLMEBOT_APIKEY=
WHATSAPP_MIN_SCORE=70

# === Browser worker ===
# Discovery and draft fill only. Keep submit false. Do not enable live submission.
BROWSER_WORKER_ENABLED=true
BROWSER_ALLOW_SUBMIT=false
# Optional. Playwright storage_state JSON path for a manually logged-in session.
# Never put portal passwords in env, code, or the database.
BROWSER_STORAGE_STATE_PATH=
APPLICATION_PREP_INTERVAL_MINUTES=30
